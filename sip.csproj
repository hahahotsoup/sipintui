<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sip</AssemblyName>
    <RootNamespace>Sip</RootNamespace>
    <Version>1.2.1</Version>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除测试工程,避免 SDK 默认 Glob 把 tests/**/*.cs 编进主程序 -->
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- 语言文件默认外置（发布时复制到 exe 旁 languages/，可编辑定制） -->
    <None Include="languages\**\*.json" />
    <!-- 同时内嵌为程序集资源，单文件即自带官方翻译：数据目录缺失时自动恢复 -->
    <EmbeddedResource Include="languages\**\*.json">
      <LogicalName>sip-lang.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 语言文件用自定义复制（不走 CopyToOutputDirectory/CopyToPublishDirectory，避免单文件发布的 MSB3094 冲突）：
       Build 后复制到 bin，Publish 后复制到发布目录 -->
  <Target Name="CopyLanguagesToOutput" AfterTargets="Build">
    <ItemGroup>
      <_LangFiles Include="languages\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_LangFiles)" DestinationFolder="$(OutputPath)languages\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLanguagesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LangFiles Include="languages\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_LangFiles)" DestinationFolder="$(PublishDir)languages\" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="ktsu.CredentialCache" Version="1.3.19" />
    <!-- SQLCipher:孟思琳(simon)挡位 3 的数据加密。
         SQLCipher provider 最高 2.1.11,故 Microsoft.Data.Sqlite 降到 9.x(依赖 2.1.x),
         SQLitePCLRaw 全家统一 2.1.11(10.x 依赖 core 3.x 与 sqlcipher 不兼容)。
         入口 SetProvider(e_sqlcipher)覆盖默认 provider;未加密库行为不变 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlcipher" Version="2.1.11" />
    <!-- bundle 保持 2.1.11(2.1.13 会把 provider.e_sqlite3 拉高,与 SQLCipher provider 2.1.11 上限冲突 NU1605) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <!-- 混版修复:core + 原生库 lib.e_sqlite3 升 2.1.13(2.1.x 修复末版,消 GHSA-2m69-gcr7-jv3q);
         provider/lib.e_sqlcipher 保持 2.1.11(SQLCipher 上限)。2.1.x 线 API 兼容,挡位 3 加密由测试验证 -->
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>

</Project>